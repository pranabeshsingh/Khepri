# Pithon Mini-OpenClaw Configuration Template
# Copy this file to .env on your host and replace with actual credentials.
# NEVER commit the actual .env file to Git!

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Authorized Private Chat ID (allowed for interactive chat, tasks, web searches)
TELEGRAM_ADMIN_CHAT_ID="357035668"

# Group / Channel ID for silent hourly analytical digests (inbound messages discarded)
TELEGRAM_REPORT_CHAT_ID="-1001169201210"

# Web UI Dashboard Access Passphrase
WEB_ADMIN_PASSWORD="set_a_secure_passphrase_here"

# Timezone for temporal grounding and reminders
TIMEZONE="Asia/Kolkata"

# Internal container port (mapped to 127.0.0.1:8091 on host)
PORT="8080"
