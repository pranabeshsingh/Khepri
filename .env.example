# Khepri Autonomous Agent Configuration Template
# Copy this file to .env on your host and replace with your actual credentials.
# NEVER commit the actual .env file to Git!

# Telegram Bot Token (obtained from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Authorized Private Chat ID (allowed for interactive chat, tasks, notes, tool calling)
# Retrieve using @userinfobot or @raw_data_bot on Telegram
TELEGRAM_ADMIN_CHAT_ID="your_admin_chat_id_here"

# Group / Channel ID for silent periodic analytical digests (optional)
TELEGRAM_REPORT_CHAT_ID="your_report_group_id_here"

# Web UI Management Portal Passphrase
WEB_ADMIN_PASSWORD="set_a_secure_passphrase_here"

# Timezone for temporal grounding and scheduled reminders
TIMEZONE="Asia/Kolkata"

# Internal container port (mapped to 127.0.0.1:8091 on host)
PORT="8080"
